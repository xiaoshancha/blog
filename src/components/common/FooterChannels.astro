---
import { siteConfig } from '../../site.config';

const icons: Record<string, string> = {
  wechat: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.3 4.1C4.6 4.1 1.7 6.6 1.7 9.7c0 1.8 1 3.5 2.8 4.6l-.8 2.4 2.8-1.4c.6.1 1.1.2 1.7.2 3.7 0 6.6-2.5 6.6-5.6S12 4.1 8.3 4.1Zm-2.1 4.4a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8Zm4.2 0a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8Z"/><path d="M16.5 10.1c-3.1 0-5.7 2-5.7 4.6 0 1.4.8 2.8 2.2 3.7l-.6 1.8 2.1-1.1c.4.1.8.1 1.3.1 3.1 0 5.7-2 5.7-4.6s-2.6-4.5-5.7-4.5Zm-1.8 3.5a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4Zm3.6 0a.7.7 0 1 1 0-1.4.7.7 0 0 1 0 1.4Z"/></svg>`,
  douyin: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.8 3.2c.6 1.8 1.7 3.1 3.5 3.8v3a7.3 7.3 0 0 1-3.5-1.2v5.9c0 3.7-2.6 6.1-6.2 6.1-3.2 0-5.8-2.4-5.8-5.7 0-3.7 3-6 6.4-5.7v3.1a2.7 2.7 0 0 0-.7-.1c-1.4 0-2.6 1-2.6 2.6 0 1.4 1 2.5 2.4 2.5 1.6 0 2.3-1 2.3-2.9V3.2h4.2Z"/></svg>`,
  email: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5h18A1.5 1.5 0 0 1 22.5 7v10A1.5 1.5 0 0 1 21 18.5H3A1.5 1.5 0 0 1 1.5 17V7A1.5 1.5 0 0 1 3 5.5Zm0 2.1v.2l9 6.2 9-6.2v-.2H3Zm18 2.7-8.6 5.9a.8.8 0 0 1-.8 0L3 10.3V17h18v-6.7Z"/></svg>`,
};
---

<div class="footer-channels" aria-label="Contact channels">
  {siteConfig.footerChannels.map((channel) => {
    const icon = icons[channel.key] ?? icons.email;
    return channel.href ? (
      <a
        class="footer-channel"
        href={channel.href}
        aria-label={`${channel.label}: ${channel.value}`}
        target={channel.href.startsWith('http') ? '_blank' : undefined}
        rel={channel.href.startsWith('http') ? 'noreferrer' : undefined}
      >
        <Fragment set:html={icon} />
        <span class="footer-tooltip">{channel.label}: {channel.value}</span>
      </a>
    ) : (
      <div class="footer-channel" aria-label={`${channel.label}: ${channel.value}`}>
        <Fragment set:html={icon} />
        <span class="footer-tooltip">{channel.label}: {channel.value}</span>
      </div>
    );
  })}
</div>
