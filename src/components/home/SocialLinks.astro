---
import type { ProfileEntry } from '../../utils/content';

interface Props {
  title: string;
  profile: ProfileEntry;
}

const { title, profile } = Astro.props;
---

<section class="content-section">
  <div class="section-heading">
    <span class="section-index">07</span>
    <h2>{title}</h2>
  </div>
  <div class="social-grid">
    {profile.data.socials.map((social) => (
      social.href ? (
        <a class="social-card" href={social.href} target="_blank" rel="noreferrer">
          <span>{social.label}</span>
          <strong>{social.handle}</strong>
        </a>
      ) : (
        <div class="social-card">
          <span>{social.label}</span>
          <strong>{social.handle}</strong>
        </div>
      )
    ))}
  </div>
</section>
