---
import type { ProfileEntry } from '../../utils/content';

interface Props {
  title: string;
  profile: ProfileEntry;
}

const { title, profile } = Astro.props;
const href = profile.data.emailHref?.trim();
const isLink = /^(https?:\/\/|mailto:)/.test(href);
---

<section class="content-section contact-shell" id="contact">
  <div class="section-heading">
    <p>/ 05</p>
    <h2>{title}</h2>
  </div>
  <div class="contact-card">
    {isLink ? (
      <a class="contact-link" href={href} target="_blank" rel="noreferrer">
        {profile.data.emailLabel}
      </a>
    ) : (
      <div class="contact-text">
        <strong>{profile.data.emailLabel}</strong>
        <p>{href}</p>
      </div>
    )}
    {profile.data.contactNote ? <p>{profile.data.contactNote}</p> : null}
  </div>
</section>
