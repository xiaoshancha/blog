---
import type { ProfileEntry } from '../../utils/content';

interface Props {
  title: string;
  profile: ProfileEntry;
  dictionary: Record<string, string>;
}

const { title, profile, dictionary } = Astro.props;
---

<section class="content-section" id="projects">
  <div class="section-heading">
    <span class="section-index">03</span>
    <h2>{title}</h2>
  </div>
  <div class="project-grid">
    {profile.data.projects.map((project) => (
      <article class="project-card">
        <div class="project-meta">
          <span>{project.year}</span>
          <span>
            {project.visibility === 'private'
              ? dictionary.projectVisibilityPrivate
              : dictionary.projectVisibilityPublic}
          </span>
          {project.href ? (
            <a href={project.href} target="_blank" rel="noreferrer">{dictionary.projectOpen}</a>
          ) : (
            <span>{dictionary.projectPrivate}</span>
          )}
        </div>
        <h3>{project.name}</h3>
        <p>{project.summary}</p>
        <ul class="chip-list">
          {project.stack.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
