---
interface Props {
  title: string;
  content: any;
}

const { title, content: Content } = Astro.props;
---

<section class="content-section">
  <div class="section-heading">
    <span class="section-index">02</span>
    <h2>{title}</h2>
  </div>
  <div class="bio-copy prose-shell">
    <Content />
  </div>
</section>
