---
import { getDictionary } from '../i18n/config';
import { siteConfig } from '../site.config';
import type { SiteLocale } from '../site.config';
import { homePath, postsPath, setupPath } from '../utils/i18n';
import FooterChannels from '../components/common/FooterChannels.astro';
import '../styles/global.css';

interface Alternate {
  hrefLang: string;
  href: string;
}

interface Props {
  locale: SiteLocale;
  title: string;
  description: string;
  canonicalPath: string;
  alternateLinks?: Alternate[];
  otherLocaleHref?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  locale,
  title,
  description,
  canonicalPath,
  alternateLinks = [],
  otherLocaleHref,
  ogImage,
  ogType = 'website',
} = Astro.props;
const dictionary = getDictionary(locale);

const canonicalUrl = `${siteConfig.site}${canonicalPath}`;
const resolvedOgImage = ogImage ?? `${siteConfig.base}/og/default.png`;
const absoluteOgImage = resolvedOgImage.startsWith('http')
  ? resolvedOgImage
  : `${siteConfig.site}${resolvedOgImage}`;
---

<!doctype html>
<html lang={locale === 'zh-cn' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafe" />
    <link rel="icon" href={`${siteConfig.base}/favicon.svg`} />
    <link rel="canonical" href={`${siteConfig.site}${canonicalPath}`} />
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.hrefLang} href={`${siteConfig.site}${link.href}`} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'zh-cn' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-shell">
      <div class="background-glow background-glow-left"></div>
      <div class="background-glow background-glow-right"></div>
      <header class="site-header">
        <nav>
          <a href={homePath(locale)}>{dictionary.navHome}</a>
          <a href={postsPath(locale)}>{dictionary.navPosts}</a>
          <a href={setupPath(locale)}>{dictionary.navSetup}</a>
          <a href={`${homePath(locale)}#contact`}>{dictionary.navContact}</a>
          {otherLocaleHref ? (
            <a href={otherLocaleHref} aria-label={dictionary.navSwitch}>
              {locale === 'zh-cn' ? dictionary.continueToEnglish : dictionary.continueToChinese}
            </a>
          ) : null}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>{dictionary.footerNote}</p>
        <FooterChannels />
      </footer>
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const targets = document.querySelectorAll(
          '.content-section, .hero-panel, .hero-copy, .hero-card, .project-card, .skill-card, .social-card, .timeline-item, .post-card, .contact-card'
        );
        targets.forEach((el) => el.classList.add('reveal'));

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );

        targets.forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
