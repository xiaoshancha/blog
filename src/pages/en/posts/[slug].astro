---
import { render } from 'astro:content';
import { getPostsByLocale, getTranslatedPost, slugFromId } from '../../../utils/content';
import { postPath } from '../../../utils/i18n';
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const posts = await getPostsByLocale('en');

  return posts.map((post) => ({
    params: { slug: slugFromId(post.id) },
    props: { post },
  }));
}

const locale = 'en' as const;
const { post } = Astro.props;
const { Content } = await render(post);
const chinese = await getTranslatedPost(post, 'zh-cn');
---

<BlogPostLayout
  locale={locale}
  post={post}
  canonicalPath={postPath(locale, slugFromId(post.id))}
  alternateLinks={[
    ...(chinese ? [{ hrefLang: 'zh-CN', href: postPath('zh-cn', slugFromId(chinese.id)) }] : []),
    { hrefLang: 'en', href: postPath(locale, slugFromId(post.id)) },
  ]}
  otherLocaleHref={chinese ? postPath('zh-cn', slugFromId(chinese.id)) : undefined}
  content={Content}
/>
