---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDictionary } from '../i18n/config';
import { siteConfig } from '../site.config';
import { homePath, notFoundPath } from '../utils/i18n';

const locale = 'zh-cn' as const;
const dictionary = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  title={`${dictionary.notFoundTitle} · ${siteConfig.name}`}
  description={dictionary.notFoundBody}
  canonicalPath={notFoundPath()}
>
  <section class="not-found-shell">
    <p class="eyebrow">404</p>
    <h1>{dictionary.notFoundTitle}</h1>
    <p>{dictionary.notFoundBody}</p>
    <a class="contact-link" href={homePath(locale)}>{dictionary.notFoundCta}</a>
  </section>
</BaseLayout>
